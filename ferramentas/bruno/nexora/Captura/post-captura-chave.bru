meta {
  name: POST /captura/{chave}
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/captura/:chave
  body: json
  auth: none
}

params:path {
  chave: {{chaveFormulario}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nome": "",
    "telefone": "",
    "email": "{{email}}",
    "mensagem": "",
    "armadilha": ""
  }
}
