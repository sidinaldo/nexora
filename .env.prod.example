# =============================================================================
#  Nexora — variáveis de PRODUÇÃO.
#
#  Copie para `.env.prod` DIRETO NO SERVIDOR e preencha lá. O `.env.prod` está
#  no .gitignore e não pode voltar para o repositório em nenhuma hipótese.
#
#      cp .env.prod.example .env.prod
#      nano .env.prod
#      chmod 600 .env.prod
#
#  Gere cada segredo com:
#      openssl rand -hex 32
#
#  ⚠️ NENHUM VALOR REAL NESTE ARQUIVO. Ele é versionado. Os campos de segredo
#  ficam VAZIOS de propósito — o compose usa a forma `${VAR:?}`, que ABORTA o
#  `up` com o nome da variável faltando em vez de subir com um padrão inseguro.
# =============================================================================

# ---------------------------------------------------------------- domínios
# O domínio da API, apontado para o IP deste VPS. É o que o Caddy usa para pedir
# o certificado.
DOMINIO_API=appnexora.duckdns.org

# Para onde o Let's Encrypt avisa que um certificado vai expirar sem renovar.
ACME_EMAIL=

# ===== O DOMÍNIO DO PAINEL (Cloudflare Pages) =====
# Vai para DOIS lugares: `Cors:Origens` (sem ele o navegador barra o painel) e
# `Email:BaseUrlPainel` (sem ele o link de convite leva a lugar nenhum).
#
# COM https://, SEM barra no final. Origem de CORS é comparada como string
# exata: "https://x.pages.dev/" com barra NÃO casa com "https://x.pages.dev".
PAINEL_URL=https://SEU-PROJETO.pages.dev

# ---------------------------------------------------------------- banco do Nexora
POSTGRES_DB=nexora
POSTGRES_USER=nexora
# openssl rand -hex 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- autenticação
# MÍNIMO 32 caracteres — o boot da API derruba a aplicação com menos, de
# propósito. Trocar esta chave invalida todos os tokens emitidos: todo mundo
# precisa entrar de novo (é assim que se revoga sessão hoje — ver docs/INF-1.md).
# openssl rand -hex 32
JWT_CHAVE=

# ---------------------------------------------------------------- Evolution
EVOLUTION_IMAGE=evoapicloud/evolution-api
EVOLUTION_TAG=v2.3.7
EVOLUTION_LOG_LEVEL=ERROR,WARN

# A chave que autentica as chamadas do Nexora para a Evolution (header `apikey`).
# Quem tiver esta chave E alcançar a Evolution manda mensagem pelo número do
# cliente. Ela não é alcançável de fora — mas gere uma forte assim mesmo.
# openssl rand -hex 32
EVOLUTION_API_KEY=

# Senha do Postgres da Evolution (container próprio, isolado).
# openssl rand -hex 32
EVOLUTION_DB_PASS=

# ---------------------------------------------------------------- webhook
# A ÚNICA barreira do endpoint que recebe as mensagens: a Evolution não assina o
# payload. Quem acertar este valor injeta "o contato respondeu" no sistema.
#
# ⚠️ O boot NÃO valida entropia — só recusa vazio. Um valor curto sobe sem
# reclamação (docs/SEGURANCA.md, achado 6). Use o comando abaixo.
# openssl rand -hex 24
WEBHOOK_SEGREDO=

# ---------------------------------------------------------------- cadastro
# Autoriza criar empresa (header X-Chave-Admin). Vazia DESLIGA o cadastro, que é
# o padrão seguro do código — mas o compose exige preenchida, porque sem ela não
# há como criar a primeira empresa. Comparada em tempo constante.
# openssl rand -hex 32
CADASTRO_CHAVE_ADMIN=

# ---------------------------------------------------------------- e-mail
# `arquivo` (padrão) grava as mensagens em disco em vez de enviar: serve para
# subir sem SMTP e ver o link de convite no log. Troque para `smtp` quando tiver
# provedor — sem isso ninguém recebe convite nem "esqueci minha senha".
EMAIL_PROVEDOR=arquivo
EMAIL_HOST=
EMAIL_PORTA=587
EMAIL_USAR_SSL=true
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE=nao-responda@exemplo.com
EMAIL_NOME_REMETENTE=Nexora

# ---------------------------------------------------------------- agendador
# Fuso em que a rodada diária de follow-up acorda. Errado, ela dispara na hora
# errada — e "hora errada" aqui significa mensagem para cliente de madrugada.
AGENDADOR_FUSO=America/Sao_Paulo
AGENDADOR_HORA=8
