# Copie para .env e preencha. O .env NAO vai para o git.
#   cp .env.example .env
#
# Este arquivo configura APENAS o docker-compose (as dependencias de dev).
# Os segredos da APLICACAO ficam em user-secrets, nunca aqui:
#   dotnet user-secrets set "ConnectionStrings:Nexora" "..."  --project src/Nexora.Api
#   dotnet user-secrets set "Jwt:Chave" "..."                 --project src/Nexora.Api
#   dotnet user-secrets set "Evolution:ApiKey" "..."          --project src/Nexora.Api
#   dotnet user-secrets set "Webhook:Segredo" "..."           --project src/Nexora.Api
#
# E-MAIL: em desenvolvimento o padrao (Email:Provedor=arquivo) grava as mensagens em
# src/Nexora.Api/bin/.../emails-dev em vez de enviar. Para usar SMTP de verdade:
#   dotnet user-secrets set "Email:Provedor" "smtp"           --project src/Nexora.Api
#   dotnet user-secrets set "Email:Host"     "smtp.provedor"  --project src/Nexora.Api
#   dotnet user-secrets set "Email:Usuario"  "..."            --project src/Nexora.Api
#   dotnet user-secrets set "Email:Senha"    "..."            --project src/Nexora.Api
# Usuario e Senha NUNCA entram no appsettings.json — ele e versionado.
#
# ATENCAO: os valores abaixo tem que BATER com o docker-compose.yml. No Recupera esses
# dois arquivos ficaram dessincronizados (tag v2.2.3 no exemplo x v2.3.7 no compose,
# porta 8080 x 8081, e uma variavel de banco que nem era mais usada) — quem seguia o
# `cp .env.example .env` caia em confusao. Ao mexer num, confira o outro.

# ---------- Postgres do Nexora ----------
POSTGRES_DB=nexora
POSTGRES_USER=nexora
# Gere uma forte:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Porta no HOST. 5433 evita conflito com um Postgres ja instalado na 5432.
POSTGRES_PORT=5433

# ---------- Evolution API ----------
# Confira a versao v2 mais recente antes de subir.
EVOLUTION_IMAGE=evoapicloud/evolution-api
EVOLUTION_TAG=v2.3.7

# Porta no HOST (o container escuta 8080 internamente).
# 8082 evita conflito com outras Evolutions ja rodando na maquina.
EVOLUTION_PORT=8082

# URL publica da propria Evolution (ela usa para montar links de midia).
# Tem que refletir EVOLUTION_PORT.
EVOLUTION_SERVER_URL=http://localhost:8082

# Chave de acesso a API da Evolution (voce inventa; e o header `apikey` nas chamadas).
# Gere uma forte:  openssl rand -hex 32
# O MESMO valor vai para o user-secret Evolution:ApiKey da API.
EVOLUTION_API_KEY=

# Senha do Postgres DELA (container proprio, isolado do nosso).
EVOLUTION_DB_PASS=evolution_dev

# Para onde a Evolution manda os eventos (mensagem recebida, ACK, conexao).
# O container alcanca o host por host.docker.internal; a porta e a da API .NET
# (perfil "http" do launchSettings = 5123).
#
# O `token` na query e a UNICA barreira do webhook: a Evolution nao assina o payload.
# Use o MESMO valor do user-secret Webhook:Segredo.
#   Gere:  openssl rand -hex 24
WEBHOOK_URL=http://host.docker.internal:5123/api/webhook/evolution?token=SEGREDO_AQUI

EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO
