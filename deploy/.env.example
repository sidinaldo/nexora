# ==========================================================================================
#  Modelo do `.env` de produção. Copie para `deploy/.env` e preencha.
#
#  ⚠️ O `deploy/.env` NÃO VAI PARA O GIT. Confira no `.gitignore` antes de preencher.
#
#  Gere todo segredo com `openssl rand -hex 32` — nunca escolha um à mão. Senha escolhida por
#  pessoa entra em lista de senha vazada; 32 bytes de CSPRNG não.
# ==========================================================================================

# ---------------------------------------------------------------- Cloudflare
# O token do Tunnel, criado em Zero Trust → Networks → Tunnels. Ele é a credencial que autentica
# a VPS na borda: quem tiver este valor consegue publicar como se fosse você.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- domínios
# O painel, no Cloudflare Pages. Vai para o CORS e para o link dos e-mails de convite.
# ⚠️ SEM BARRA NO FIM: a comparação de origem do CORS é exata, e "https://x/" não casa com
# "https://x".
NEXORA_PUBLIC_PANEL_URL=https://nexora.softioconsultoria.com.br

# ---------------------------------------------------------------- banco
# Três senhas distintas, e a razão é o isolamento: o usuário `evolution` não conecta no database
# `nexora`, então comprometer o contêiner da Evolution — que roda Baileys e é a maior superfície
# do sistema — não dá acesso às conversas dos clientes.
POSTGRES_PASSWORD=
NEXORA_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=

# ---------------------------------------------------------------- aplicação
# Mínimo 32 caracteres — a API recusa subir com menos.
JWT_CHAVE=

# A mesma chave alimenta o contêiner da Evolution e o cliente HTTP da API.
EVOLUTION_API_KEY=

# Autentica o webhook que a Evolution manda de volta. É a única barreira daquele endpoint.
WEBHOOK_SEGREDO=

# ⚠️ VAZIA DESLIGA O CADASTRO de empresas novas. Deixe preenchida enquanto estiver criando os
# clientes piloto, e esvazie depois.
CADASTRO_CHAVE_ADMIN=

# ---------------------------------------------------------------- o IP do cliente
# ⚠️ ATRÁS DO CLOUDFLARE TEM DE SER `CF-Connecting-IP` — é o default do compose, e mudar isto
# quebra duas coisas em silêncio: o rate limit colapsa num balde só, e o IP que vai para a Meta
# vira o do datacenter, piorando a atribuição de anúncio.
RATE_LIMIT_CABECALHO_IP=CF-Connecting-IP

# ---------------------------------------------------------------- e-mail
# ⚠️ `arquivo` NÃO ENVIA NADA, grava em disco. Com ele, convite e "esqueci minha senha" falham
# em silêncio — ninguém recebe e nenhum erro aparece. Troque para `smtp` antes do primeiro
# cliente.
# ⚠️ E use a porta 587 (STARTTLS): a 465 não funciona com o cliente SMTP da BCL.
EMAIL_PROVEDOR=arquivo
EMAIL_HOST=
EMAIL_PORTA=587
EMAIL_USAR_SSL=true
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_REMETENTE=nao-responda@softioconsultoria.com.br
EMAIL_NOME_REMETENTE=Nexora

# ---------------------------------------------------------------- backup
# ⚠️ SEM A SENHA O BACKUP RECUSA RODAR. Os dumps têm conversa, telefone e foto de TERCEIROS.
#
# ⚠️ E GUARDE-A FORA DESTA MÁQUINA, num gerenciador de senhas. Ela mora neste arquivo, que está
# no disco que o backup existe para sobreviver. Senha só aqui = backup ilegível no dia em que
# ele for preciso.
BACKUP_SENHA=

# Cloudflare R2. A credencial deve ter permissão de ESCRITA apenas — a retenção de 14 dias é
# regra de ciclo de vida do bucket, e uma credencial que apaga backup é uma credencial que um
# invasor usa para apagar backup.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BACKUP=nexora-backups

# Uptime Kuma, monitor do tipo Push. O script chama esta URL ao TERMINAR BEM; o Kuma alerta pela
# ausência do chamado.
BACKUP_PUSH_URL=

# ---------------------------------------------------------------- agendador
# Fuso da rodada diária. Errado, ela dispara na hora errada — e "hora errada" aqui significa
# mensagem de follow-up para cliente de madrugada.
AGENDADOR_FUSO=America/Sao_Paulo
AGENDADOR_HORA=8

# ---------------------------------------------------------------- Evolution
EVOLUTION_IMAGE=evoapicloud/evolution-api
EVOLUTION_TAG=v2.3.7
EVOLUTION_LOG_LEVEL=ERROR,WARN

# ---------------------------------------------------------------- memória
# Somam ~6 GB numa máquina de 8. O que sobra NÃO é desperdício: é o page cache que o Postgres usa
# para não ir ao disco.
#
# Sem limite, quem estoura a memória não é quem morre: o kernel mata o MAIOR processo, que quase
# sempre é o Postgres — e aí um cliente derruba todos.
LIMITE_CLOUDFLARED=128m
LIMITE_API=1g
LIMITE_DB=1536m
LIMITE_EVOLUTION=3g
LIMITE_BACKUP=256m
